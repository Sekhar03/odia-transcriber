# Google OAuth Client ID (required for Vercel/cloud caption extraction)
# Create at: https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3 for the project
# Authorized JavaScript origins: https://odia-transcriber.vercel.app, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Optional: Override API base URL for frontend (leave empty for same-origin)
# VITE_API_BASE_URL=

# Optional: InnerTube API key (defaults to built-in public key)
# INNERTUBE_API_KEY=your_innertube_api_key_here
